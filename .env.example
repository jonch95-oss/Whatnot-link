# Whatnot account credentials
WHATNOT_USERNAME=your_email@example.com
WHATNOT_PASSWORD=your_password

# URL of the show you are modding (the one to collect users from)
TARGET_SHOW_URL=https://www.whatnot.com/live/SHOW_ID_HERE

# URL of YOUR show (the one to tag users in)
OWN_SHOW_URL=https://www.whatnot.com/live/YOUR_SHOW_ID

# How long (seconds) to stay on the target show collecting usernames
COLLECT_DURATION_SECONDS=120

# Delay between each @tag message in your show (seconds) — keep >=2 to avoid rate limits
TAG_DELAY_SECONDS=2.5

# Optional: message to send after the @tag
TAG_MESSAGE=Come check out this show! 🔥

# Skip your own username when collecting (true/false)
SKIP_OWN_USERNAME=true
