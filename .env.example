# Whatnot account credentials
WHATNOT_USERNAME=your_email@example.com
WHATNOT_PASSWORD=your_password

# Show(s) you are modding — comma-separate multiple URLs to collect from all of them
TARGET_SHOW_URL=https://www.whatnot.com/live/SHOW_ID_HERE

# URL of YOUR show (where users will be @tagged)
OWN_SHOW_URL=https://www.whatnot.com/live/YOUR_SHOW_ID

# How long (seconds) to watch each target show for chatters
COLLECT_DURATION_SECONDS=120

# Delay between each @tag message (seconds) — keep >=2 to avoid rate limits
TAG_DELAY_SECONDS=2.5

# Message sent after the @username
TAG_MESSAGE=Come check out this show!

# Only tag users who sent at least this many chat messages (filters lurkers/bots)
MIN_MESSAGES=1
